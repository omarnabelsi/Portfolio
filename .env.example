# Production URL — used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Optional public contact details. Leave empty to hide them.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form delivery (https://resend.com). Without all three, the form
# replies "not connected yet" (HTTP 503) instead of pretending to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
